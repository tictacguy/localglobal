# Copy to .env and fill in real values before `docker compose up`.
# NEVER commit the real .env.

# Public origin (used for CORS + CSRF origin checks). Must match the domain served by Caddy.
PUBLIC_ORIGIN=https://localglobal.it

# Postgres password (choose a strong value).
POSTGRES_PASSWORD=change-this-to-a-strong-password

# JWT signing secret — generate with: openssl rand -base64 48
JWT_SECRET=change-this-to-a-long-random-secret

# Password for the seeded demo account (alberto@localglobal.it). Change it.
SEED_DEMO_PASSWORD=Password123!
